{
 "name": "parity",
 "description": "Numerical agreement at a size every implementation can run: 1 million rows, 8,000 providers, 50 features, each implementation at its tightest tolerance.",
 "datasets": [
  {
   "family": "cox",
   "rows": 1000000,
   "providers": 8000,
   "features": 50,
   "design": "simple"
  },
  {
   "family": "logistic_fe",
   "rows": 1000000,
   "providers": 8000,
   "features": 50,
   "design": "simple"
  },
  {
   "family": "cox",
   "rows": 1000000,
   "providers": 8000,
   "features": 50,
   "design": "correlated"
  },
  {
   "family": "logistic_fe",
   "rows": 1000000,
   "providers": 8000,
   "features": 50,
   "design": "correlated"
  }
 ],
 "models": {
  "cox": [
   {
    "family": "cox",
    "ties": "breslow",
    "strata": "provider",
    "convergence": "tight"
   }
  ],
  "logistic_fe": [
   {
    "family": "logistic_fe",
    "convergence": "tight"
   }
  ]
 },
 "adapters": [
  "engine",
  "pprof_spark",
  "pprof_spark_cached",
  "lab_spark",
  "pprof_py",
  "pprof_r",
  "lab_numpy"
 ],
 "repeats": 1,
 "options": {
  "driver_memory_fraction": 0.4,
  "timeout_s": 7200,
  "clear_cache": true,
  "cache_input": false
 }
}