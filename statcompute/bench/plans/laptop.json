   "rows": 200000,
   "providers": 400,
   "features": 20,
   "design": "simple"
  },
  {
   "family": "cox",
   "rows": 200000,
   "providers": 400,
   "features": 50,
   "design": "simple"
  },
  {
   "family": "logistic_fe",
   "rows": 200000,
   "providers": 400,
   "features": 50,
   "design": "simple"
  }
 ],
 "models": {
  "cox": [
   {
    "family": "cox",
    "ties": "breslow",
